# Keep third-party integrations empty for local development unless needed.
PAYMENT_PROVIDER=bachs
PAYMENT_CALLBACK_URL=
# Percentage deducted from new gifts in NGN and USD. Restart after changing; 0 disables fees.
# Each gift keeps the fee quoted when it was initiated.
GIFT_FEE_PERCENT=2
# USD card/unknown-method earnings are held this many weekday days, in Lagos time.
USD_SETTLEMENT_BUSINESS_DAYS=2.5
# Total creator-paid NGN withdrawal fee. USD conversion quotes keep the provider's expiry.
NGN_WITHDRAWAL_FEE=100
# Percentage added to the requested USD withdrawal amount; no fixed minimum or cap.
USD_WITHDRAWAL_FEE_PERCENT=1
WITHDRAWAL_QUOTE_TTL_SECONDS=300
BACHS_API_KEY=
BACHS_BASE_URL=https://sandbox-api.bachs.io
BACHS_WEBHOOK_SECRET=
BACHS_RETURN_URL=
BACHS_CANCEL_URL=
BACHS_GIFT_RETURN_URL=
BACHS_GIFT_CANCEL_URL=
PAYSTACK_SECRET_KEY=
KORA_SECRET_KEY=
KORA_PUBLIC_KEY=
KORA_ENCRYPTION_KEY=
RESEND_API_KEY=
